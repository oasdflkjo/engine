#version 430
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer Particles {
    vec4 particles[];
};

uniform float delta_time;
uniform vec2 gravity_point;
uniform int num_particles;
uniform float attraction_strength;
uniform float time_scale;

void main() {
    uint global_id = gl_GlobalInvocationID.x;
                    
    if (global_id >= num_particles) return;

    vec2 position = particles[global_id].xy;
    vec2 velocity = particles[global_id].zw;

    // Update position with scaled time
    position += velocity * delta_time * time_scale;
    
    // Simple attraction to gravity point with configurable strength
    vec2 to_gravity = gravity_point - position;
    vec2 direction = vec2(0.0);
    float dist2 = dot(to_gravity, to_gravity);
    if (dist2 > 1e-12) {
        direction = to_gravity * inversesqrt(dist2);
    }

    velocity += direction * attraction_strength * delta_time * time_scale;
    
    // Simple dampening
    velocity *= 0.9988;

    particles[global_id] = vec4(position, velocity);
}
