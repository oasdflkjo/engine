#############################################
# Utility command for update_mappings

build external/glfw/src/update_mappings: phony external/glfw/src/CMakeFiles/update_mappings


#############################################
# Utility command for package

build external/glfw/src/CMakeFiles/package.util: CUSTOM_COMMAND external/glfw/src/all
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\projects\engine\build_debug && "C:\Program Files\CMake\bin\cpack.exe" --config ./CPackConfig.cmake"
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build external/glfw/src/package: phony external/glfw/src/CMakeFiles/package.util


#############################################
# Utility command for package_source

build external/glfw/src/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\projects\engine\build_debug && "C:\Program Files\CMake\bin\cpack.exe" --config ./CPackSourceConfig.cmake C:/projects/engine/build_debug/CPackSourceConfig.cmake"
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build external/glfw/src/package_source: phony external/glfw/src/CMakeFiles/package_source.util


#############################################
