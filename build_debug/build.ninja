build external/glfw/src/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\projects\engine\build_debug\external\glfw\src && "C:\Program Files\CMake\bin\cmake-gui.exe" -SC:\projects\engine -BC:\projects\engine\build_debug"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build external/glfw/src/edit_cache: phony external/glfw/src/CMakeFiles/edit_cache.util


